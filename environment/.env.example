# ==========================================
# License Configuration
# ==========================================
# License state storage is resolved internally per OS under a JCP-VISION/<app_code>/<license_hash>.json path.
# No env or pyproject.toml override is required for the state file location.
LICENSE_KEY=<your_license_key_here>

# ==========================================
# Django Superuser Credentials
# ==========================================
# Used for initial superuser creation if required
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=root
DJANGO_SUPERUSER_EMAIL=jonathanchacko1805@gmail.com

# ==========================================
# System Configurations (Overrides pyproject.toml)
# ==========================================
# You can override the settings from pyproject.toml here.
# Note: Variables defined here will take priority over pyproject.toml settings.
# Ensure boolean values are written as "true", "1", "yes" or "false" (lowercase is standard).

# --- [tool.configs] ---
web_label_printer=true
transaction_approval_needed=true
login_auth_needed=true
allow_order_entry=true
check_periodic=true
license_check_interval_seconds=300
login_barcode_override=false # Override login with barcode instead of QR code.

# --- [tool.order_details] ---
allow_order_scan=true
order_scan_regex=''
enforce_js_regex=true

# ==========================================
# Database Configuration
# ==========================================
# To use a custom database (MySQL, PostgreSQL), set `custom_engine = true` 
# in pyproject.toml under [tool.database] and fill out these values.
# If `custom_engine = false` or the connection fails, it falls back to SQLite.
custom_engine=false

# DB Engine Options:
# MySQL: django.db.backends.mysql
# PostgreSQL: django.db.backends.postgresql
# SQLite: django.db.backends.sqlite3
db_engine=django.db.backends.mysql

# Database Credentials
db_name=scanstock_db
db_user=root
db_password=your_password_here
db_host=127.0.0.1
db_port=3306

# Note: The system will automatically attempt to create the database (DB_NAME) 
# if it does not already exist on the MySQL/PostgreSQL server.
